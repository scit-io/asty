# Vite loads this file only on `npm run dev` (and `vite preview`), never
# on production builds (those use .env.production / runtime injection).
# Mirror of deploy/dev/.env A_TOKEN — the orchestrator's tokenAuth
# middleware rejects writes (drain, scale, deploy, …) without it.
VITE_ASTY_TOKEN=dev-token-secret

# Backend origin the SPA calls directly (no dev proxy). asty.test is a
# /etc/hosts name start.sh points at every node's loopback alias, so the
# browser fails over across nodes at the DNS layer. The dashboard's CORS
# layer permits this cross-origin call from the Vite dev server.
VITE_ASTY_ORIGIN=http://asty.test:7060
