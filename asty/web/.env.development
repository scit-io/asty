# Vite loads this file only on `npm run dev` (and `vite preview`), never
# on production builds (those use .env.production / runtime injection).
# Mirror of deploy/dev/.env A_TOKEN — the orchestrator's tokenAuth
# middleware rejects writes (drain, scale, deploy, …) without it.
VITE_ASTY_TOKEN=dev-token-secret

# @asty-web-app/compass bootstrap URL — where the SPA fetches the live
# host list from. Default ('/api/v1' on the SPA's own origin) won't
# work in dev because the Vite dev server doesn't expose the gateway,
# so we point at the seed node's gateway on :80 directly.
VITE_ASTY_BOOTSTRAP_URL=http://asty.test/api/v1

# In dev the gateway returns bare hostnames (n1.asty.test, …) and the
# dashboard listens on :7060 over plain http. Tell compass to build
# origins with that scheme + port. In prod both should be unset —
# defaults are https:// without a port, correct for TLS-terminated
# cluster endpoints.
VITE_ASTY_SCHEME=http://
VITE_ASTY_PORT=7060

# Compass fallback origin — used when bootstrap fails or returns no
# hosts. In dev the gateway and dashboard are on different ports
# (gateway :80, dashboard :7060), so the fallback points at the
# dashboard's port directly. asty.test maps to every node's loopback
# alias via /etc/hosts; the dashboard CORS layer permits the
# cross-origin call from the Vite dev server.
VITE_ASTY_ORIGIN=http://asty.test:7060

# Compass debug logging: prints bootstrap URL, fallback, picked origin,
# and per-host latencies to the browser console. Useful for verifying
# the selection actually happened.
VITE_COMPASS_DEBUG=true
