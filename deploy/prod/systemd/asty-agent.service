# asty-agent — supervises the local nats-server, runs the embedded
# gateway, and is the parent of every user-service process on this
# node. Must start before asty-server: the server connects to NATS,
# and NATS is the agent's child, so without a live agent the server
# has nothing to talk to.
#
# Privilege model: this unit runs as root (User= is unset → systemd
# default) so the agent can bind :80 for the gateway and exec
# nats-server while still privileged. The agent then:
#   - exec's nats-server under uid=nobody (Credential on the cmd),
#   - pre-binds the gateway socket on :80 (still root),
#   - setuid/setgid to `nobody` for the rest of its lifetime.
# From that point onward every fork+exec spawn (user services)
# naturally inherits the nobody identity. No dedicated `asty` service
# user is created or required.
#
# Alternative on Linux that skips the root phase entirely: set
# User=nobody Group=nobody here and
# AmbientCapabilities=CAP_NET_BIND_SERVICE so the agent can bind :80
# without root. The agent's resolveDropTarget then sees euid != 0
# and disables the drop sequence — the OS already placed us where
# we want to be.
#
# Operator install:
#   mkdir -p /var/lib/asty && chown nobody:nobody /var/lib/asty
#   cp deploy/prod/systemd/asty-agent.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now asty-agent
#
# Tuning:
#   - EnvironmentFile=/etc/asty/asty.env carries A_TOKEN and NATS
#     passwords. No run-as env vars — Asty's drop target is the
#     standard `nobody` user, hardcoded.
#   - LimitNOFILE bumped so a busy gateway can hold many WS clients.
#   - Restart=always with a small backoff so a crash loop is visible
#     to systemd journal but the cluster heals itself.
#   - StartLimitBurst caps the loop; past it systemd backs off and
#     the heartbeat going stale tells the leader to migrate allocs.

[Unit]
Description=Asty agent — process supervisor + embedded gateway + NATS supervisor
Documentation=https://github.com/example/asty/blob/main/CLAUDE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# No User= / Group= — agent starts as root so it can bind :80 and
# exec nats-server, then drops itself to `nobody` (hardcoded in
# resolveDropTarget). If the host has no `nobody` user the drop is
# skipped with a loud log message.
WorkingDirectory=/var/lib/asty
ExecStart=/usr/local/bin/asty -mode agent -config /etc/asty/config.asty
EnvironmentFile=-/etc/asty/asty.env

# nats-server child + many gateway connections + many spawned services.
LimitNOFILE=65535
LimitNPROC=8192

# Stop semantics: SIGTERM, give the agent up to a minute to drain
# its supervised processes cleanly before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=10

# Hardening — leave the kernel surface as narrow as the agent can
# tolerate. The agent itself needs to spawn user processes so we
# can't strip CAP_SYS_ADMIN entirely on systems that need cgroup
# attribution, but everything below is safe.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
