# deploy/dev/dev.vars
#
# Secrets and per-service tunables for local dev.
# Asty itself reads deploy/dev/config.asty; what stays here is what
# either belongs in env (secrets) or feeds the demo x-services (their
# .asty files reference $X_*).
#
# Loaded by start.sh, which exports every K=V line into the asty
# server/agent processes.

# =============================================================================
# NATS authentication
# =============================================================================
# config.asty defines two NATS accounts: ASTY (KV + app traffic) and SYS
# (server observability only). Three users, three passwords:
#   - asty-agent    in ASTY — agent's main connection (cluster KV, asty.v1.*)
#   - asty-app      in ASTY — handed to spawned demo services via A_NATS_*
#   - asty-observer in SYS  — agent's STATSZ/JSZ poller for node-NATS metrics
# All three passwords are substituted into config.asty at load time via
# ${VAR} expansion. Missing any of them lets the corresponding user
# authenticate with an empty password, which NATS will refuse.

# Password for the ASTY user the agent runs as.
A_NATS_PASSWORD          = "dev-agent-secret"

# Password for the ASTY user the demo services run as.
A_NATS_APP_PASSWORD      = "dev-app-secret"

# Password for the SYS user the agent uses to poll $SYS.REQ.SERVER.*.
A_NATS_OBSERVER_PASSWORD = "dev-observer-secret"

# =============================================================================
# Asty cluster
# =============================================================================

# Bearer token used by Asty server/agent to authenticate to each other
# (kept here so it's not in a checked-in YAML).
A_TOKEN         = "dev-token-secret"

# =============================================================================
# Fake hardware (dev cluster simulation) — SINGLE SOURCE OF TRUTH
# =============================================================================
# Every dev-only override the agent uses to pretend nodes are smaller
# than the host lives here. Changing a value here propagates to:
#   - the agent (read via env on heartbeat)
#   - docker-compose container limits (${VAR} substitution)
# Don't duplicate any of these elsewhere.

# Total CPU advertised to the scheduler (MHz).
A_CPU_TOTAL              = 2200

# Total memory advertised to the scheduler (MB). Also caps the NATS
# and Postgres docker containers via ${A_MEMORY_TOTAL}M substitution.
A_MEMORY_TOTAL           = 512

# Total disk advertised to the scheduler (MB). 20 GiB.
A_DISK_TOTAL             = 20480

# Total swap advertised to the scheduler (MB). 1 GiB (≈ 5% of disk).
A_SWAP_TOTAL             = 1024

# Synthetic OS-footprint baseline on the fake disk (MB). Treats this
# many MB as "used by OS" so a fresh dev node doesn't look 0% full.
# Default ≈ 20% of A_DISK_TOTAL — realistic for a minimal Linux box.
A_DISK_OS_BASELINE       = 4096

# Synthetic NATS-binary disk baseline (MB). NATS runs in Docker so
# its real binary size isn't visible to the agent; we count this plus
# actual JetStream bytes as the NATS card's disk usage.
A_NATS_DISK_BASELINE     = 30

# Docker CPU limit (fractional cores) for NATS + Postgres containers,
# substituted into docker-compose.yml. Independent of A_CPU_TOTAL
# because Docker uses cores and Asty uses MHz.
A_DOCKER_CPUS            = 1.0

# =============================================================================
# xauth (demo) — JWT authentication service
# =============================================================================

# Accepted login username.
X_AUTH_USERNAME       = "admin"

# Accepted login password (plain-text — dev only).
X_AUTH_PASSWORD       = "password"

# HMAC key for signing access tokens (short-lived).
X_AUTH_ACCESS_SECRET  = "dev-access-secret"

# HMAC key for signing refresh tokens (long-lived).
X_AUTH_REFRESH_SECRET = "dev-refresh-secret"

# Cookie Domain attribute (empty — current host).
X_AUTH_COOKIE_DOMAIN  = ""

# Cookie Secure flag (false in dev — no TLS).
X_AUTH_COOKIE_SECURE  = "false"

# Cookie SameSite policy (lax in dev for cross-port browsing).
X_AUTH_COOKIE_SAMESITE = "lax"

# Access token lifetime.
X_AUTH_ACCESS_TTL     = "15m"

# Refresh token lifetime.
X_AUTH_REFRESH_TTL    = "168h"

# =============================================================================
# xhttp (demo) — CRUD service backed by PostgreSQL
# =============================================================================

# PostgreSQL connection string (matches docker-compose Postgres credentials).
X_HTTP_DATABASE_URL = "postgres://platform:platform@localhost:5432/platform?sslmode=disable"

# KV cache entry lifetime.
X_HTTP_CACHE_TTL    = "30s"

# =============================================================================
# xws (demo) — WebSocket session manager
# =============================================================================

# Idle WS session timeout — closes inactive sessions after this duration.
X_WS_INACTIVITY_TIMEOUT = "3m"
