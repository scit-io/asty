# deployments/envs/dev/dev.vars
#
# Переменные для локального запуска Asty (dev-режим).
# Не содержит секретов — только dev-значения.
# Используется скриптом start.sh.

# NATS (без авторизации в dev)
A_NATS_USER     = ""
A_NATS_PASSWORD = ""

# Asty orchestrator
A_DOMAIN            = "dev.local"
A_TOKEN             = "dev-token-secret"
A_DATACENTER        = "dc1"
A_LOG_LEVEL         = "debug"
A_MIN_COPIES        = "3"
A_TARGET_CPU        = "75"
A_TARGET_MEMORY     = "75"
A_TRAFFIC_RPS_THRESHOLD = "5"
A_UI_ADDR           = "127.0.0.1:4747"
A_WORK_DIR          = "/tmp/asty-dev/work"
A_CPU_TOTAL         = 2200
A_MEMORY_TOTAL      = 466

# Gateway
A_ALLOWED_HOSTS            = "localhost:3000,localhost:5173"
A_GATEWAY_AUTH_RATE_PREFIX = "/v1/auth/"

# xauth
X_AUTH_USERNAME       = "admin"
X_AUTH_PASSWORD       = "password"
X_AUTH_ACCESS_SECRET  = "dev-access-secret"
X_AUTH_REFRESH_SECRET = "dev-refresh-secret"
X_AUTH_COOKIE_DOMAIN       = ""
X_AUTH_COOKIE_SECURE       = "false"
X_AUTH_ACCESS_TTL     = "15m"
X_AUTH_REFRESH_TTL    = "168h"

# xhttp
X_HTTP_DATABASE_URL  = "postgres://platform:platform@localhost:5432/platform?sslmode=disable"
X_HTTP_CACHE_TTL     = "30s"

# xws
X_WS_INACTIVITY_TIMEOUT = "3m"

# Health check addresses for platform services (port 0 = OS picks free port)
X_HEALTH_ADDR = "127.0.0.1:0"
