# xws service — WebSocket session manager
# Type: service — autoscaled by Asty
# User: asty — non-privileged user

name: xws
type: service

artifact:
  url: https://github.com/${GITHUB_REPO}/releases/download/${VERSION}/xws_linux_${ARCH}.tar.gz
  checksum: ${CHECKSUM}

command: ./xws
user: asty
kill_timeout: 10s

env:
  A_NATS_HOST: "127.0.0.1"
  A_NATS_PORT: "4222"
  A_NATS_USER: "${A_NATS_USER}"
  A_NATS_PASSWORD: "${A_NATS_PASSWORD}"
  A_LOG_LEVEL: "${A_LOG_LEVEL}"
  X_WS_INACTIVITY_TIMEOUT: "${X_WS_INACTIVITY_TIMEOUT}"

resources:
  cpu: 100       # MHz
  memory: 32     # MB

health:
  type: nats
  subject: xws.ping
  interval: 10s
  timeout: 3s

logs:
  max_files: 5
  max_file_size: 10  # MB

update:
  max_parallel: 1
  min_healthy_time: 10s
  healthy_deadline: 3m
  progress_deadline: 10m
  auto_revert: true

restart:
  attempts: 10
  interval: 5m
  delay: 15s
