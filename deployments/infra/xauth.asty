# xauth service — JWT authentication with HttpOnly cookies and NATS KV
# Type: service — managed by autoscaler (locality-aware placement)

name: xauth
type: service

artifact:
  url: https://github.com/${GITHUB_REPO}/releases/download/${VERSION}/xauth_linux_${ARCH}.tar.gz
  checksum: ${CHECKSUM}

command: ./xauth
user: asty
kill_timeout: 30s

env:
  A_NATS_HOST: "127.0.0.1"
  A_NATS_PORT: "4222"
  A_NATS_USER: "${A_NATS_USER}"
  A_NATS_PASSWORD: "${A_NATS_PASSWORD}"
  X_AUTH_USERNAME: "${X_AUTH_USERNAME}"
  X_AUTH_PASSWORD: "${X_AUTH_PASSWORD}"
  X_AUTH_ACCESS_SECRET: "${X_AUTH_ACCESS_SECRET}"
  X_AUTH_REFRESH_SECRET: "${X_AUTH_REFRESH_SECRET}"
  X_AUTH_ACCESS_TTL: "${X_AUTH_ACCESS_TTL}"
  X_AUTH_REFRESH_TTL: "${X_AUTH_REFRESH_TTL}"
  X_AUTH_COOKIE_DOMAIN: "${X_AUTH_COOKIE_DOMAIN}"
  X_AUTH_COOKIE_SECURE: "${X_AUTH_COOKIE_SECURE}"
  X_AUTH_COOKIE_SAMESITE: "${X_AUTH_COOKIE_SAMESITE}"
  X_HEALTH_ADDR: "${ASTY_HEALTH_ADDR}"
  A_LOG_LEVEL: "${A_LOG_LEVEL}"

kv:
  - bucket: authms_refresh_tokens
    history: 1
    replicas: 3

resources:
  cpu: 100       # MHz
  memory: 32     # MB

health:
  type: http
  path: /healthz
  interval: 10s
  timeout: 3s

logs:
  max_files: 5
  max_file_size: 10  # MB

update:
  max_parallel: 1
  min_healthy_time: 10s
  healthy_deadline: 3m
  progress_deadline: 10m
  auto_revert: true

restart:
  attempts: 10
  interval: 5m
  delay: 15s
